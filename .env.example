# Nova-AI local development / deployment template
# Never commit real secrets. Copy to .env and fill in real values.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Explicit reverse-proxy hop count for Express client-IP/rate-limit handling.
# Keep 0/empty when Node is directly exposed; set only to the known trusted hops.
TRUST_PROXY_HOPS=0

# PostgreSQL
DATABASE_URL=
DATABASE_SSL_CA=

# Redis / BullMQ (optional in local development)
REDIS_URL=

# Gemini
# Gemini 2.0 Flash shut down June 2026. Use a supported model.
# Changing this model may change provider pricing/behavior; test before rollout.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Meta WhatsApp Cloud API
META_GRAPH_API_VERSION=v23.0
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# 32-byte credential-encryption key.
# Use either 64 hex characters OR base64 that decodes to exactly 32 bytes.
CREDENTIAL_ENCRYPTION_KEY=

# JWT
JWT_SECRET=
JWT_ISSUER=nova-ai
JWT_AUDIENCE=nova-ai-api
JWT_EXPIRES_IN=15m

# Privacy/data-retention windows in days (7–3650; adjust to your published policy).
# Defaults: deleted messages 90, completed inbox 30, usage 365, OCR 90,
# payment detail events 90, expired refresh tokens 30, AI memory/signals/
# summaries/copilot drafts 365. Payment replay keys are retained separately.
RETENTION_DELETED_MESSAGES_DAYS=90
RETENTION_WEBHOOK_COMPLETED_DAYS=30
RETENTION_USAGE_EVENTS_DAYS=365
RETENTION_OCR_DOCUMENTS_DAYS=90
RETENTION_PAYMENT_EVENTS_DAYS=90
RETENTION_EXPIRED_REFRESH_TOKENS_DAYS=30
RETENTION_AI_MEMORY_DAYS=365
RETENTION_AI_SIGNALS_DAYS=365
RETENTION_AI_SUMMARIES_DAYS=365
RETENTION_AI_DRAFTS_DAYS=365
RETENTION_CLEANUP_INTERVAL_MS=86400000

# WhatsApp delivery recovery window (60 seconds to 24 hours)
WHATSAPP_DELIVERY_RETRY_WINDOW_SECONDS=900

# Automation webhook security (comma-separated exact HTTPS hostnames)
AUTOMATION_WEBHOOK_ALLOWLIST=

# Per-tenant payment webhook signing secrets (PAYMENT_WEBHOOK_SECRETS).
# A JSON object mapping tenant UUIDs to independent, high-entropy HMAC-SHA256
# secrets (>= 32 chars; use 64 random hex chars). The payment webhook endpoint
# (/api/payments/webhook/:tenantId) authenticates each request with the TARGET
# tenant's own key and FAILS CLOSED (HTTP 403) when a tenant's key is missing,
# malformed, or unknown. This prevents one tenant's signer from forging events
# that mutate another tenant's payments.
#
# DEPLOYMENT NOTE: integrations that previously signed with the single shared
# PAYMENT_WEBHOOK_SECRET must be configured with their correct tenant-specific
# key here BEFORE rollout. The legacy shared secret no longer authenticates this
# endpoint and is never used as a fallback.
#
# Replace the placeholders below with real per-tenant secrets in your deployment.
# Never commit real credentials.
PAYMENT_WEBHOOK_SECRETS={"<TENANT_1_UUID>":"<REPLACE_WITH_64_RANDOM_HEX_CHARS_FOR_TENANT_1>","<TENANT_2_UUID>":"<REPLACE_WITH_64_RANDOM_HEX_CHARS_FOR_TENANT_2>"}

# DEPRECATED: legacy shared payment-webhook signing secret. No longer used by the
# payment webhook endpoint (kept empty). Do not rely on it for payment webhooks.
PAYMENT_WEBHOOK_SECRET=
