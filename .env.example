NODE_ENV=production
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://user:pass@host:5432/nova_ai
DB_CA_CERT=
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_POOL_MIN=0
REDIS_URL=redis://default:pass@host:6379
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_LONG_EXAMPLE
JWT_ISSUER=nova-ai
JWT_AUDIENCE=nova-ai-api
JWT_EXPIRES_IN=15m
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
CREDENTIAL_ENCRYPTION_KEY=
QUEUE_CONCURRENCY=5
QUEUE_RATE_MAX=20
TENANT_RATE_LIMIT=300
